# Frontend API Configuration (local development)
# For local testing, use the Django backend on 127.0.0.1:8000.
# For production on Plesk (bhisha.com), see .env.production.
REACT_APP_API_BASE_URL=http://127.0.0.1:8000/api/auth/

# Keep React dev server local-only by default.
HOST=localhost
PORT=3000

# Fallback options (keep commented unless needed):
REACT_APP_USE_SAME_ORIGIN_API=false
# REACT_APP_API_PROTOCOL=http:
# REACT_APP_API_HOST=127.0.0.1
# REACT_APP_API_PORT=8000
