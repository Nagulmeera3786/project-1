# Core Django
SECRET_KEY=change-this-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# For split hosting (Netlify frontend + separate Django backend):
CORS_ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-site.netlify.app

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/abc_sms
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# Optional explicit PostgreSQL fields when DATABASE_URL is not used
# DB_NAME=abc_sms
# DB_USER=postgres
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Admin mailbox: also used as the sender identity for OTP / forgot-password / reset-password mail
PRIMARY_ADMIN_EMAIL=admin@yourdomain.com

# Gmail Configuration for OTP emails
# To use real email sending:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Generate an app password at https://myaccount.google.com/apppasswords
# 3. Copy your 16-character app password below

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com

# Microsoft Graph API mail sending (Entra ID app, client-credentials flow).
# To use instead of SMTP: set EMAIL_PROVIDER=graph and fill these in.
# Setup: Entra admin center -> App registrations -> New registration ->
# API permissions -> add "Mail.Send" (Application) -> grant admin consent ->
# Certificates & secrets -> New client secret.
# EMAIL_PROVIDER=graph
# GRAPH_TENANT_ID=your-directory-tenant-id
# GRAPH_CLIENT_ID=your-application-client-id
# GRAPH_CLIENT_SECRET=your-client-secret-value
# GRAPH_SENDER_EMAIL=admin@yourdomain.com   # defaults to PRIMARY_ADMIN_EMAIL if unset

# Email validation third-party providers (optional; leave blank to use own system only)
ZEROBOUNCE_API_KEY=
MILLIONVERIFIER_API_KEY=

# Real-time SMS Provider Configuration
# These map to your working script values:
# user   -> SMS_PROVIDER_USER
# pwd    -> SMS_PROVIDER_PASSWORD
# sender -> SMS_DEFAULT_SENDER_IDS (comma-separated if multiple)
SMS_PROVIDER_USER=YOUR_PROFILE_ID
SMS_PROVIDER_PASSWORD=YOUR_PASSWORD
SMS_PROVIDER_URL=https://mshastra.com/bsms/buser/send_sms_center.aspx
SMS_PROVIDER_JSON_URL=https://mshastra.com/sendsms_api_json.aspx
SMS_DEFAULT_SENDER_IDS=SENDERID

# India DLT defaults (used when destination_country=IN and request omits DLT fields)
SMS_DLT_TEMPLATE_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TELEMARKETER_ID=

# Verifalia email validation
VERIFALIA_API_BASE_URL=https://api.verifalia.com/v2.6
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD=
VERIFALIA_WAIT_TIMEOUT_SECONDS=15

